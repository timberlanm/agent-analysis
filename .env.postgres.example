# PostgreSQL runtime connection (soc_app)
DATABASE_URL=postgresql+psycopg://soc_app:<app-password>@192.168.50.132:5432/soc_platform_dev
REQUIRE_POSTGRESQL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# Persistent application state such as the Flask session signing key.
APP_DATA_DIR=<absolute-runtime-data-directory>

# Absolute path on the application host. The database stores only paths
# relative to this directory, so Windows and Linux may use different roots.
INCIDENT_UPLOAD_DIR=<absolute-attachment-directory>

# Only set these while running Alembic or the SQLite migration.
MIGRATION_DATABASE_URL=postgresql+psycopg://soc_migrator:<migrator-password>@192.168.50.132:5432/soc_platform_dev
