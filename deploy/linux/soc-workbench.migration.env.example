# Used only by bootstrap or an explicitly approved Alembic migration.
# Never reference this file from soc-workbench.service.
MIGRATION_DATABASE_URL=postgresql+psycopg://soc_migrator:<migrator-password>@127.0.0.1:5432/soc_platform_dev

# Used by bootstrap.sh only when the local roles/database do not exist.
SOC_MIGRATOR_PASSWORD=<migrator-password>
SOC_APP_PASSWORD=<app-password>
