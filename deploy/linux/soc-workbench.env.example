# PostgreSQL runtime connection. Use the restricted soc_app role here.
DATABASE_URL=postgresql+psycopg://soc_app:<app-password>@127.0.0.1:5432/soc_platform_dev
REQUIRE_POSTGRESQL=true

# Runtime state must remain outside the source tree.
APP_DATA_DIR=/var/lib/soc-workbench/data
INCIDENT_UPLOAD_DIR=/var/lib/soc-workbench/uploads/incident

# SQLAlchemy connection pool. Each Gunicorn worker owns one pool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# The test environment is served over HTTP. Enable secure cookies only after
# HTTPS is configured in front of the application.
SECURE_COOKIE=false
COOKIE_SAMESITE=Lax

# The Linux service receives configuration exclusively from this file.
APP_SKIP_LOCAL_ENV=1

# Linux preflight guards.
EXPECTED_DATABASE_NAME=soc_platform_dev
EXPECTED_DATABASE_USER=soc_app
